# npm run build (site, yönetim paneli, yazar paneli): .env'deki değerlerin derlenmiş sürümde değişenleri. Derlenenler
# arka uçtan tek adresten sunulur (backend/pipeline/api.py): site /, yönetim paneli /yonetim/, yazar paneli /yazar/.
# .env git'e girmediği için koleksiyonun arka uçtan gelmesi burada da açık olmalı; yoksa build 6 örnek eserle çalışır.
VITE_VAKIF_API=1
VITE_ADMIN_URL=/yonetim/
