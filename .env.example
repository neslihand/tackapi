# EŞİK'in bütün ayarları tek yerde. Bu dosyayı aynı klasöre .env adıyla kopyala ve değerleri doldur:
#   cp .env.example .env
# .env git'e girmez. Arka uç (uvicorn ve pipeline betikleri), site, yönetim paneli, yazar paneli ve mobil uygulama onu
# kendiliğinden okur; ayrıca 'export' ya da '$env:' gerekmez. Kabukta verilen değer dosyadakinin önüne geçer.
# Derlenen site ve panellerin (npm run build) ek ayarları .env.production dosyasında.

# --------------------------------------------------------------------------------------------- arka uç (gizli)
# PostgreSQL (pgvector ve pg_trgm eklentileriyle).
DATABASE_URL=postgresql://kullanici:sifre@localhost:5432/vakif
# Gemini API anahtarı. Boşsa site açılır; yalnızca "Esere Sor" ve yapay zekâ taslakları çalışmaz.
GEMINI_API_KEY=
# Yönetim paneli girişleri, 'ad:anahtar,ad2:anahtar2' (anahtar en az 16 karakter). Panelde ':' işaretinden sonrası yazılır.
# Boşsa yönetim uçları kapalıdır.
VAKIF_ADMIN_TOKENS=

# --------------------------------------------------------------------------------------------- arka uç (ayarlar)
# Arka uca doğrudan istek atabilecek ön yüz adresleri (Vite 5173, mobilin Expo web'i 8081).
VAKIF_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081
# Ekonomik sohbet modu (soru başına tek model çağrısı) ve cevap önbelleği.
VAKIF_ECO=1
VAKIF_CACHE=1
# İsteğe bağlı: kitap PDF'lerinin klasörü (paneldeki PDF sayfa görünümü için). Diğer ayarlar: backend/README.md §11.
# VAKIF_PDF_DIR=

# --------------------------------------------------------------------------------------------- site ve paneller
# Bu bölümde VITE_ ile başlayanlar tarayıcıya gömülür: buraya gizli bilgi yazma.
# 1 ise koleksiyon, eser sayfaları, "Esere Sor", kamera ve harita arka uçtan gelir; boşsa site 6 örnek eserle çalışır.
VITE_VAKIF_API=1
# Geliştirmede (npm run dev) site, yönetim paneli ve yazar paneli /api ve /media isteklerini bu adrese yönlendirir.
VAKIF_API_PROXY=http://127.0.0.1:8000
# Geliştirmede yönetim panelinin adresi (sitedeki "Yönetim Paneli" bağlantısı). Derlenmiş sürümde /yonetim/.
VITE_ADMIN_URL=http://127.0.0.1:5174
# Geliştirmede sitenin adresi: yönetim panelinin eser önizlemesi sitenin kendi sayfasını gösterir. Derlenmiş sürümde /.
VITE_SITE_URL=http://127.0.0.1:5173/
# Android APK indirme adresi (EAS derlemesi; bkz. mobile/README.md). Boşsa sitede "Android sürümü yolda" yazar.
VITE_MOBILE_APK_URL=
# "Esere Sor" için başka bir sohbet servisi kullanılacaksa adresi. Boşsa /api/chat kullanılır.
VITE_CHAT_API_URL=

# --------------------------------------------------------------------------------------------- mobil
# Uygulamaya gömülür: gizli bilgi yazma. Boşsa uygulama Expo sunucusunu çalıştıran bilgisayarın 8000 portuna bağlanır;
# telefonda Ayarlar'dan da değiştirilebilir. Telefon 127.0.0.1'e değil kendi kendine bağlanır: bilgisayarın yerel ağ
# adresini yaz (ör. http://192.168.1.20:8000) ve arka ucu --host 0.0.0.0 ile başlat. Android öykünücüde http://10.0.2.2:8000.
EXPO_PUBLIC_API_URL=
