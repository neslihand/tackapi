{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mobile-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "mobile",
        "run",
        "web",
        "--",
        "--port",
        "8081"
      ],
      "env": {
        "CI": "1"
      },
      "port": 8081
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "web-demo",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5175"
      ],
      "env": {
        "VITE_VAKIF_API": ""
      },
      "port": 5175
    },
    {
      "name": "mobile-web-alt",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "mobile",
        "run",
        "web",
        "--",
        "--port",
        "8082"
      ],
      "env": {
        "CI": "1",
        "EXPO_PUBLIC_API_URL": "http://127.0.0.1:8001"
      },
      "port": 8082,
      "autoPort": false
    },
    {
      "name": "mobile-web-faz2",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "mobile",
        "run",
        "web",
        "--",
        "--port",
        "8083"
      ],
      "env": {
        "CI": "1",
        "EXPO_PUBLIC_API_URL": "http://127.0.0.1:8001"
      },
      "port": 8083,
      "autoPort": false
    }
  ]
}
