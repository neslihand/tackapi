# Arka uç adresi (backend/pipeline/api.py). Telefon 127.0.0.1'e değil kendi kendine bağlanır: bilgisayarın yerel ağ
# adresini yaz (ör. http://192.168.1.20:8000) ve arka ucu `--host 0.0.0.0` ile başlat. Android öykünücüde
# http://10.0.2.2:8000 kullanılabilir. Bu değer uygulamaya gömülür: gizli bilgi yazma.
EXPO_PUBLIC_API_URL=http://192.168.1.20:8000
