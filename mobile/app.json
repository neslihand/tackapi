{
  "expo": {
    "name": "TAÇKAPI",
    "slug": "tackapi-mobil",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "tr.girlsandcodes.tackapi",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Yakınındaki vakıf eserlerini göstermek ve yerinde mühür basmak için konumun kullanılır; konumun cihazından çıkmaz.",
        "NSCameraUsageDescription": "Bir yapının fotoğrafını çekip hangi eser olduğunu bulmak için.",
        "NSPhotoLibraryUsageDescription": "Galerindeki bir fotoğrafla eser aramak için."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F2F26",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "tr.girlsandcodes.tackapi",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-image",
      [
        "expo-notifications",
        {
          "color": "#C3A869"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Yakınındaki vakıf eserlerini göstermek ve yerinde mühür basmak için konumun kullanılır; konumun cihazından çıkmaz."
        }
      ],
      "expo-font",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F2F26",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-sharing"
    ],
    "scheme": "tackapi",
    "backgroundColor": "#0F2F26",
    "description": "TAÇKAPI — Tarihe Açılan Kapı: vakıf eserlerini kaynağıyla keşfet, yerinde mühürle.",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "927cf470-4cf1-47ff-88ff-6e8c86ae5efa"
      }
    }
  }
}
