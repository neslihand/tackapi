# npm run build: derlenen site arka uçtan tek adresten sunulur (backend/pipeline/api.py). Yönetim paneli aynı
# adreste /panel/ altındadır. Geliştirmedeki (npm run dev) ayarlar .env dosyasında.
# .env git'e girmediği için koleksiyonun arka uçtan gelmesi burada da açık olmalı; yoksa build 6 örnek eserle çalışır.
VITE_VAKIF_API=1
VITE_ADMIN_URL=/panel/
