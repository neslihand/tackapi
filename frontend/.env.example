# Vakıf Eserleri arka ucu (backend/pipeline/api.py). 1 ise koleksiyon (şimdilik yalnızca pilot eserler), eser
# sayfaları, "Esere Sor", kamera ve harita arka uçtan gelir; boşsa site yerleşik 6 örnek eserle çalışır.
VITE_VAKIF_API=1

# Geliştirmede /api ve /media isteklerini arka uca yönlendirir (CORS gerekmez, fotoğraflar aynı kökenden gelir).
# Eski ad CHAT_API_PROXY de çalışır.
VAKIF_API_PROXY=http://127.0.0.1:8000

# Yönetim paneli (../admin) adresi; sitedeki "Yönetim Paneli" bağlantısı buraya gider.
VITE_ADMIN_URL=http://127.0.0.1:5174

# "Esere Sor" için başka bir sohbet servisi kullanılacaksa adresi. Boşsa VITE_VAKIF_API=1 iken /api/chat kullanılır.
# Bu değerler tarayıcıya gömülür: buraya API anahtarı veya gizli bilgi yazma.
VITE_CHAT_API_URL=
